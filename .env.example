# Database (server-only)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Supabase (server-only unless used in client)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# NextAuth + site URL (REQUIRED in production — set in Coolify Environment Variables)
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
# Live domain — must match your Coolify domain exactly (https://yourdomain.com)
NEXTAUTH_URL=https://yourdomain.com
# Public site URL for Easebuzz surl/furl (WordPress bridge). Same as NEXTAUTH_URL in production.
SITE_URL=https://yourdomain.com

# Coolify (auto-injected by Coolify — optional to set manually)
# COOLIFY_URL=https://yourdomain.com
# COOLIFY_FQDN=yourdomain.com

# Coolify app settings:
# - Build Pack: Nixpacks OR Dockerfile
# - Port Exposes: 3000
# - Start command: npm run start  (listens on 0.0.0.0)
# - Mark all secrets as "Runtime" variables (not only Build)

# Razorpay (server-only)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_SECRET=your-razorpay-secret

# Public Razorpay Key (safe for browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id

# Email (server-only)
BREVO_API_KEY=your-brevo-api-key
SENDER_EMAIL=your-verified-brevo-sender@example.com

# Easebuzz Payment Gateway (server-only)
EASEBUZZ_KEY=your-easebuzz-merchant-key
EASEBUZZ_SALT=your-easebuzz-salt
EASEBUZZ_ENV=test
EASEBUZZ_URL=https://pay.easebuzz.in
EASEBUZZ_STATUS_URL=https://dashboard.easebuzz.in/transaction/v2.1/retrieve

# DollerpayX / BossPay bridge (runs INSIDE this Next.js app — NO separate service)
# DollerpayX / WordPress call https://<domain>/bosspay/v1/* or /wp-json/bosspay/v1/*
BOSSPAY_BRIDGE_SECRET=change-me-to-a-long-random-string
BOSSPAY_API_BASE=https://dpxreal.com/backend-api
