# Database (server-only)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Supabase (server-only unless used in client)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# NextAuth + site URL (REQUIRED in production on your hosting panel)
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
# Live domain — used for login, emails, and Easebuzz payment callbacks
# Local: http://localhost:3000  |  Production: https://yourdomain.com
NEXTAUTH_URL=http://localhost:3000

# Razorpay (server-only)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_SECRET=your-razorpay-secret

# Public Razorpay Key (safe for browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id

# Email (server-only)
BREVO_API_KEY=your-brevo-api-key
SENDER_EMAIL=your-verified-brevo-sender@example.com

# Easebuzz Payment Gateway (server-only)
EASEBUZZ_KEY=your-easebuzz-merchant-key
EASEBUZZ_SALT=your-easebuzz-salt
EASEBUZZ_ENV=test
